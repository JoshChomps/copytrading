# Copy to .env and fill in. NEVER commit .env.
# For GitHub Actions: add each as a Repository secret with the SAME name
# (repo -> Settings -> Secrets and variables -> Actions -> New repository secret).
# Everything works with all of these empty; each one upgrades a capability.

# Live congress trades (both chambers, free tier) + company news
COPYTRADE_FINNHUB_API_KEY=

# Price fallback with true dividend+split-adjusted closes (free tier)
# COPYTRADE_TIINGO_API_KEY=

# Bulk live congress feed, no symbol blind spot (paid, quiverquant.com)
# COPYTRADE_QUIVER_API_KEY=

# Raises OpenFIGI CUSIP->ticker rate limits for 13F backfills (free)
# COPYTRADE_OPENFIGI_API_KEY=

# Discord/Telegram-compatible webhook for live alerts
COPYTRADE_WEBHOOK_URL=

# Override the EDGAR contact (fair-access rules require a reachable email)
# COPYTRADE_EDGAR_USER_AGENT="copytrade-research you@example.com"

# Phase 8 paper trading (orders-push-alpaca). PAPER keys only — the client
# refuses live endpoints unless COPYTRADE_ALLOW_LIVE=1 is set deliberately.
# ALPACA_API_KEY_ID=
# ALPACA_API_SECRET_KEY=
# ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets
